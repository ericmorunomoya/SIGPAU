# ============================================================
# .env.example — Variables de entorno para Vault SIGPAU
# Copiar a .env y rellenar con valores REALES.
# NUNCA commitear el .env en Git.
# ============================================================

# Contraseña base de datos SIGPAU
DB_PASS=CAMBIAR_AQUI

# Credenciales LDAP
LDAP_ADMIN_PASS=CAMBIAR_AQUI
LDAP_REPL_PASS=CAMBIAR_AQUI

# Acceso SSH a los nodos
SSH_PASS=CAMBIAR_AQUI

# NAS
NAS_SMB_PASS=CAMBIAR_AQUI

# Grafana
GRAFANA_PASS=CAMBIAR_AQUI
